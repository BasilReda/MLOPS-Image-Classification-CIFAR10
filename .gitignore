# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Data (DVC-tracked, not git-tracked)
/data/raw/*
!/data/raw/.gitkeep

# Model checkpoints (DVC-tracked, not git-tracked)
/models/**/*.pt
!/models/**/.gitkeep

# DVC local cache/remote
/.dvc/cache
/.dvc/tmp
/.dvc/config.local

# MLflow local tracking (SQLite backend + artifact store)
mlflow.db
mlflow-artifacts/
mlruns/

# Reports (regenerated by pipeline runs)
/reports/figures/*
!/reports/figures/.gitkeep
/reports/metrics/*
!/reports/metrics/.gitkeep

# Test/coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Docker
docker-compose.override.yml
